# fnmusic-ext cmd/stop_callback
# 极简：只做 kill
PID_FILE="/tmp/fnmusic-ext.pid"
if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE")"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    sleep 1
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PID_FILE"
fi
exit 0
